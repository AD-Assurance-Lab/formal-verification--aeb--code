# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Experiment outputs (large, regenerable)
results/**/*.npz
results/**/*.png
data/
*.ckpt
*.pt
*.pth
*.onnx

# Reference PDFs and large binaries never go in git
*.pdf

# Editor / OS
.DS_Store
*.swp

# Files on their way out. Inspect, then delete. Anything ever committed stays
# recoverable from git history, so parking a tracked file here loses nothing.
stale/

# Capture campaign output: large, regenerable from tools/capture_campaign.py
results/captures/*.npz

# The simulator's own stdout. It is append-only, it reaches hundreds of megabytes in a
# session, and it is regenerable by definition. It was tracked and near-empty at the last
# push, then `git add -A` committed it seventeen times in one day at 867 MB, and GitHub
# refused the push. Logs the study reads are small and stay tracked; this one is not one.
results/carla_server.log
results/carla_launch.log
